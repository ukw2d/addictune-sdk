# Addictune SDK configuration

# API base URL (default: AudioAddict API)
ADDICTUNE_API_BASE=https://api.audioaddict.com/v1

# Default network slug (di, radiotunes, rockradio, jazzradio, classicalradio, zenradio)
ADDICTUNE_NETWORK=di

# Request timeout in seconds
ADDICTUNE_TIMEOUT=30.0

# Override individual network names (optional)
# ADDICTUNE_NETWORKS__di=DI.FM
# ADDICTUNE_NETWORKS__radiotunes=RadioTunes
# ADDICTUNE_NETWORKS__rockradio=RockRadio
# ADDICTUNE_NETWORKS__jazzradio=JazzRadio
# ADDICTUNE_NETWORKS__classicalradio=ClassicalRadio
# ADDICTUNE_NETWORKS__zenradio=ZenRadio

# Transport resilience overrides (optional)
# ADDICTUNE_RETRY__MAX_ATTEMPTS=3
# ADDICTUNE_RETRY__WAIT_MIN=2.0
# ADDICTUNE_RETRY__WAIT_MAX=10.0
# ADDICTUNE_CIRCUIT__FAILURE_THRESHOLD=5
# ADDICTUNE_CIRCUIT__RECOVERY_TIMEOUT=60.0
